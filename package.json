{
    "name": "parts-unknown",
    "private": true,
    "packageManager": "bun@1.3.14",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "bun run --filter '@repo/web' dev",
        "build": "bun run --filter '@repo/web' build",
        "start": "bun run --filter '@repo/web' start",
        "lint": "bun run --filter '@repo/web' lint",
        "compile": "bun run --filter '@repo/web' compile"
    }
}
