{
    "$schema": "./node_modules/turbo/schema.json",
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true
        },
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".next/**", "!.next/cache/**"],
            "env": ["NEON_DATABASE_URL", "NOTION_DATABASE_ID"]
        },
        "start": {
            "cache": false,
            "persistent": true
        },
        "lint": {},
        "compile": {}
    }
}
